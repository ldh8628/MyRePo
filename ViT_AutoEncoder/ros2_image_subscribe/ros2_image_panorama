#!/usr/bin/env python

import os
import math
import numpy as np
import cv2

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import CompressedImage
from rclpy.qos import QoSProfile, QoSReliabilityPolicy, QoSHistoryPolicy

# =========================
# 0. ROS2 환경변수
# =========================
os.environ["ROS_DOMAIN_ID"] = "20"
os.environ["RMW_IMPLEMENTATION"] = "rmw_fastrtps_cpp"

# =========================
# 1. 기본 설정 (B.py와 동일)
# =========================

NUM_CAMS = 6
CAMS = [f"cam{i}" for i in range(NUM_CAMS)]

WIDTH = 640
HEIGHT = 360

fx = 401.5
fy = 401.5
cx = 320.0
cy = 180.0

K1 = -0.343698
K2 = 0.105503
K3 = 0.0
P1 = -0.001558
P2 = -0.002416

CYL_H_FOV_DEG = 77.0
CYL_V_FOV_DEG = 51.3

RESIZE_FACTOR = 1.0

PANORAMA_CROP_HEIGHT_SCALE = 0.9
PANORAMA_CROP_WIDTH_SCALE  = 0.98

TARGET_W = 1280
TARGET_H = 324

OVERLAP_PX = 190
FEATHER_STRENGTH = 1.0

PANO_DIR = "panorama_output"


# =========================
# 2. Cylindrical mapping (B.py와 동일)
# =========================

def generate_cylindrical_map(resized_w, resized_h,
                             fov_h_deg, fov_v_deg,
                             fx_src, fy_src, cx_src, cy_src,
                             resize_factor=1.0):

    fx_r = fx_src * resize_factor
    fy_r = fy_src * resize_factor
    cx_r = cx_src * resize_factor
    cy_r = cy_src * resize_factor

    fov_h_rad = math.radians(fov_h_deg)
    fov_v_rad = math.radians(fov_v_deg)

    fx_cyl = resized_w / (2.0 * math.tan(fov_h_rad / 2.0))
    fy_cyl = resized_h / (2.0 * math.tan(fov_v_rad / 2.0))
    cx_cyl = resized_w / 2.0
    cy_cyl = resized_h / 2.0

    ys, xs = np.indices((resized_h, resized_w), dtype=np.float32)

    theta = (xs - cx_cyl) / fx_cyl
    hh = (ys - cy_cyl) / fy_cyl

    xs_3d = np.sin(theta)
    ys_3d = hh
    zs_3d = np.cos(theta)

    x_n = xs_3d / zs_3d
    y_n = ys_3d / zs_3d

    r2 = x_n * x_n + y_n * y_n
    r4 = r2 * r2
    r6 = r4 * r2

    radial = 1.0 + K1*r2 + K2*r4 + K3*r6
    dx = 2.0 * P1 * x_n * y_n + P2 * (r2 + 2.0 * x_n * x_n)
    dy = P1 * (r2 + 2.0 * y_n * y_n) + 2.0 * P2 * x_n * y_n

    x_d = x_n * radial + dx
    y_d = y_n * radial + dy

    map_x = x_d * fx_r + cx_r
    map_y = y_d * fy_r + cy_r

    return map_x.astype(np.float32), map_y.astype(np.float32)


# =========================
# 3. Feather Blend (B.py와 동일)
# =========================

def feather_blend_with_pad(strips, overlap, final_w, final_h, feather_strength=1.0):
    h, w0, _ = strips[0].shape
    pano = np.zeros((final_h, final_w, 3), dtype=np.uint8)
    ypad = (final_h - h) // 2

    overlap = max(1, overlap)
    alpha = np.zeros(overlap, dtype=np.float32)
    inv_overlap = 1.0 / overlap
    gamma = 1.0 / max(0.1, feather_strength)

    for x in range(overlap):
        t = (x + 0.5) * inv_overlap
        alpha[x] = t ** gamma

    for y in range(final_h):
        sy = y - ypad
        if sy < 0 or sy >= h:
            continue

        dst = pano[y]
        # 첫 strip
        strip0 = strips[0][sy]
        curx = strip0.shape[0]   # strip0: shape (w, 3)
        dst[:curx] = strip0[:min(curx, final_w)]

        # 나머지 strips
        for i in range(1, len(strips)):
            strip = strips[i][sy]        # shape (w, 3)
            w = strip.shape[0]

            ov = min(overlap, w, curx)

            # feather 영역
            for x in range(ov):
                dst_x = curx - ov + x
                if dst_x >= final_w:
                    continue
                a = alpha[x]
                prev = dst[dst_x].astype(np.float32)
                curr = strip[x].astype(np.float32)
                dst[dst_x] = (prev * (1-a) + curr * a).astype(np.uint8)

            # non-overlap
            tail = w - ov
            for x in range(tail):
                dst_x = curx + x
                if dst_x < final_w:
                    dst[dst_x] = strip[ov+x]

            curx += tail

    return pano


# =========================
# 4. ROS2 실시간 파노라마 노드
# =========================

class RealTimePanoramaNode(Node):
    def __init__(self):
        super().__init__("realtime_panorama_node")

        # 최신 프레임 버퍼
        self.buffers = {cam: None for cam in CAMS}
        self.frame_index = 0

        # ----- B.py와 동일한 파라미터 계산 -----
        self.resized_w = int(round(WIDTH * RESIZE_FACTOR))
        self.resized_h = int(round(HEIGHT * RESIZE_FACTOR))

        self.crop_w = int(round(self.resized_w * PANORAMA_CROP_WIDTH_SCALE))
        self.crop_h = int(round(self.resized_h * PANORAMA_CROP_HEIGHT_SCALE))
        self.crop_x0 = (self.resized_w - self.crop_w) // 2
        self.crop_y0 = (self.resized_h - self.crop_h) // 2

        # cylindrical map (한 번만 계산)
        self.map_x, self.map_y = generate_cylindrical_map(
            self.resized_w, self.resized_h,
            CYL_H_FOV_DEG, CYL_V_FOV_DEG,
            fx, fy, cx, cy,
            RESIZE_FACTOR
        )

        # per-camera width 계산 (B.py와 동일)
        overlap_resized = int(round(OVERLAP_PX * RESIZE_FACTOR))
        pano_w_crop = NUM_CAMS * self.crop_w - (NUM_CAMS - 1) * overlap_resized
        scale_x = TARGET_W / pano_w_crop

        self.overlap_target = int(round(overlap_resized * scale_x))
        per_w_base = int(round(self.crop_w * scale_x))

        self.per_cam_w = [per_w_base] * NUM_CAMS
        total_now = NUM_CAMS * per_w_base - (NUM_CAMS - 1) * self.overlap_target
        delta = TARGET_W - total_now

        i = 0
        while delta > 0 and i < NUM_CAMS:
            self.per_cam_w[i] += 1
            delta -= 1
            i += 1
        i = 0
        while delta < 0 and i < NUM_CAMS:
            if self.per_cam_w[i] > 1:
                self.per_cam_w[i] -= 1
                delta += 1
            i += 1

        self.per_cam_h = self.crop_h

        self.get_logger().info(f"per_cam_w = {self.per_cam_w}, overlap_target = {self.overlap_target}")

        os.makedirs(PANO_DIR, exist_ok=True)

        qos = QoSProfile(
            history=QoSHistoryPolicy.KEEP_LAST,
            depth=5,
            reliability=QoSReliabilityPolicy.BEST_EFFORT
        )

        # 구독자 등록
        for cam in CAMS:
            topic = f"/{cam}/image_raw/compressed"
            self.create_subscription(
                CompressedImage,
                topic,
                lambda msg, cam_name=cam: self.cb(msg, cam_name),
                qos,
            )
            self.get_logger().info(f"Subscribed to {topic}")

    # ---------- 콜백 ----------
    def cb(self, msg, cam_name):
        np_arr = np.frombuffer(msg.data, np.uint8)
        frame = cv2.imdecode(np_arr, cv2.IMREAD_COLOR)
        if frame is None:
            self.get_logger().error(f"[{cam_name}] decode fail")
            return

        # 입력은 640x360 고정이지만, B.py와 동일하게 resize 한 번 수행
        if frame.shape[1] != WIDTH or frame.shape[0] != HEIGHT:
            frame = cv2.resize(frame, (WIDTH, HEIGHT))

        self.buffers[cam_name] = frame

        # 6개 모두 최신 프레임이 들어온 시점마다 파노라마 1장 생성
        if all(self.buffers[c] is not None for c in CAMS):
            self.frame_index += 1
            self.process_panorama(self.frame_index)
            self.buffers = {cam: None for cam in CAMS}

    # ---------- 파노라마 생성 (B.py main 루프의 한 프레임 부분) ----------
    def process_panorama(self, frame_idx: int):
        self.get_logger().info(f"Creating panorama for frame {frame_idx}")

        imgs = [self.buffers[c] for c in CAMS]

        strips = []
        for cam_idx in range(NUM_CAMS):
            src = imgs[cam_idx]

            # B.py와 동일: resized → remap → crop → resize
            resized = cv2.resize(src, (self.resized_w, self.resized_h))
            warped  = cv2.remap(resized, self.map_x, self.map_y, cv2.INTER_LINEAR)
            cropped = warped[
                self.crop_y0:self.crop_y0 + self.crop_h,
                self.crop_x0:self.crop_x0 + self.crop_w
            ]

            target_w = self.per_cam_w[cam_idx]
            strip = cv2.resize(cropped, (target_w, self.per_cam_h))
            strips.append(strip)

        pano = feather_blend_with_pad(
            strips,
            self.overlap_target,
            TARGET_W,
            TARGET_H,
            FEATHER_STRENGTH
        )

        out_path = os.path.join(PANO_DIR, f"pano_f{frame_idx:04d}.jpg")
        cv2.imwrite(out_path, pano)
        self.get_logger().info(f"[SAVED] {out_path}")


# =========================
# 5. main
# =========================

def main():
    rclpy.init()
    node = RealTimePanoramaNode()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()


if __name__ == "__main__":
    main()
